# Copy to backend/.env, then start Quarkus from the backend directory.
# This random example value is public. Generate your own with: openssl rand -hex 32
# Enter the same LUNCH2_ADMIN_KEY value in the Admin page. Never use a VITE_ variable for it.
LUNCH2_ADMIN_KEY=example-5f8d6af31acc2e85878459c956933057cf693ce3cd97cb3914ab2f5d2b658fc2

# Optional Gemini credentials; leave blank for deterministic fallback cards.
GEMINI_API_KEY=
LUNCH2_AI_MODEL=gemini-3.8-flash

# Local development defaults.
LUNCH2_DEMO_MODE=true
LUNCH2_PUBLIC_BASE_URL=http://localhost:5173
