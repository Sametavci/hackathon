{
  "name": "lunch2-infra",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc --noEmit",
    "synth": "cdk synth",
    "deploy": "cdk deploy --require-approval never --outputs-file cdk-outputs.json",
    "destroy": "cdk destroy --force",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.10.1",
    "aws-cdk": "2.1145.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  }
}
